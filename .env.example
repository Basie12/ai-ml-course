# Copy to .env before `npx ampx sandbox` (loaded into Lambda env at deploy time).
# This AWS org blocks Amplify SSM secrets (ssm:PutParameter deny).

STRIPE_SECRET_KEY=sk_test_...
STRIPE_PRICE_SELF_PACED=price_...
STRIPE_PRICE_COHORT=price_...
STRIPE_PRICE_MENTORSHIP=price_...
STRIPE_WEBHOOK_SECRET=whsec_...
APP_URL=http://localhost:3000
AWS_REGION=us-east-1

# Supabase (browser-safe; data is protected by Row Level Security)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server/scripts only — never prefix with NEXT_PUBLIC_
# SUPABASE_SERVICE_ROLE_KEY=
